{
    "name": "edulazaro/laracrate-docs",
    "description": "Native editable documents for Laracrate: the file is the drive index, the content lives apart. Versions, named fields and PDF export.",
    "keywords": [
        "laravel",
        "laracrate",
        "documents",
        "editor",
        "drive",
        "tiptap",
        "prosemirror",
        "versions"
    ],
    "homepage": "https://github.com/edulazaro/laracrate-docs",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Eduardo Lazaro",
            "homepage": "https://edulazaro.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "edulazaro/laracrate": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "EduLazaro\\LaracrateDocs\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EduLazaro\\LaracrateDocs\\LaracrateDocsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "EduLazaro\\LaracrateDocs\\Tests\\": "tests/"
        }
    }
}
